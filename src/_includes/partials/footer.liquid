<footer class="footer" role="contentinfo">
  <div class="container footer_inner">

    <div class="footer_grid">
      <div class="footer_about">
        <a href="/" class="footer_brand" aria-label="{{ site.name }} home">
          <svg class="footer_brand_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 9.75V20a.75.75 0 00.75.75h4.5V15a.75.75 0 01.75-.75h1.5a.75.75 0 01.75.75v5.75h4.5a.75.75 0 00.75-.75V9.75"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20.75v-3.5a1 1 0 011-1h4a1 1 0 011 1v3.5"/>
          </svg>
          <span class="footer_brand_text">{{ site.name }}</span>
        </a>
        <p>{{ site.name }} matches homeowners with pre-screened local pros across the continental United States, for everything from home renovations to emergency restoration. Request a free quote today.</p>
      </div>

      <div class="footer_col">
        <h3>Operating Hours</h3>
        {% for slot in site.hours %}
        <p>{{ slot.days }}: {{ slot.time }}</p>
        {% endfor %}
      </div>

      <div class="footer_col">
        <h3>Get In Touch</h3>
        <p><a href="mailto:{{ site.email }}">Email: {{ site.email }}</a></p>
        <p><a href="tel:+1{{ site.defaultPhone }}" data-dynamic-phone-tel>Phone: <span data-dynamic-phone>{{ site.defaultPhoneFormatted }}</span></a></p>
        <a class="footer_quote" href="/#quote">Get Your Quote</a>
      </div>
    </div>

    <div class="footer_bottom">
      <p class="footer_copyright">&copy; {{ currentYear }} {{ site.copyrightHolder }}. All Rights Reserved.</p>
      <ul class="footer_links">
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms-conditions/">Terms &amp; Conditions</a></li>
        <li><a href="/ccpa-policy/">California Privacy Rights</a></li>
        <li><a href="/ccpa/">CCPA Request Webform</a></li>
      </ul>
    </div>

  </div>
</footer>
