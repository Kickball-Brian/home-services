---
layout: layouts/base.liquid
title: "ContractorLogic | Find Trusted Home Service Contractors"
description: "Get matched with pre-screened, local home service professionals for any home project. Completely free, with no commitment required."
permalink: "/index.html"
bodyClass: "is-home"
---

{% comment %} ── Hero ── {% endcomment %}
<section class="hero" id="quote">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <div class="hero-content">
    <div class="hero-left">

      <h1>Find <em>Trusted</em><br>Home Service<br>Contractors</h1>
      <p>Get matched with pre-screened, local professionals for any home project. Completely free, with no commitment required.</p>
      <div class="hero-trust">
        <div class="trust-item">
          <div class="trust-icon">
            <svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          Free to Use
        </div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          Verified Pros
        </div>
        <div class="trust-item">
          <div class="trust-icon">
            <svg viewBox="0 0 24 24"><path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          </div>
          Top-Rated Only
        </div>
      </div>
    </div>

    <div class="hero-card">
      <h3>Get Your Free Quotes Today</h3>
      <p>Enter your ZIP code and choose a service to get matched instantly.</p>
      <div class="zip-input-group">
        <input class="zip-input" type="text" inputmode="numeric" placeholder="Enter ZIP Code" maxlength="5">
        <button class="zip-btn" type="button">Find Pros &rarr;</button>
      </div>
      <div class="service-picker-label">Select a Service</div>
      <div class="service-pills">
        <button class="service-pill active" type="button">Bathroom Remodel</button>
        <button class="service-pill" type="button">Flooring</button>
        <button class="service-pill" type="button">Garage Doors</button>
        <button class="service-pill" type="button">Home Warranty</button>
        <button class="service-pill" type="button">HVAC</button>
        <button class="service-pill" type="button">Kitchen Remodel</button>
        <button class="service-pill" type="button">Pest Control</button>
        <button class="service-pill" type="button">Roofing</button>
        <button class="service-pill" type="button">Siding</button>
        <button class="service-pill" type="button">Solar</button>
        <button class="service-pill" type="button">Water Damage</button>
        <button class="service-pill" type="button">Windows</button>
      </div>
      <div class="hero-card-footer">
        <svg viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        No spam. No obligation. We protect your privacy.
      </div>
    </div>
  </div>
</section>

{% comment %} ── Services ticker ── {% endcomment %}
{% assign tickerItems = "Kitchen Remodel,Pest Control,Roofing,Siding,Solar Energy,Water Damage,Windows,Bathroom Remodel,Flooring,Garage Doors,Home Warranty,HVAC" | split: "," %}
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <div class="ticker-group">{% for item in tickerItems %}<span class="ticker-item">{{ item }}</span>{% endfor %}</div>
    <div class="ticker-group">{% for item in tickerItems %}<span class="ticker-item">{{ item }}</span>{% endfor %}</div>
  </div>
</div>

